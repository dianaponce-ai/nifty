{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 60,
      "includeFiles": "{app/**,views/**,assets/css/**,assets/js/**,index.php}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1", "headers": { "Cache-Control": "public, max-age=2592000" } },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
